#!/bin/sh
# postinstall fuer ICST_Ambi_Reaper.pkg — $2 = Installationsort (/Applications/ICST_Ambi_Reaper)
DEST="$2"
CONSOLE_USER="$(/usr/bin/stat -f %Su /dev/console 2>/dev/null || echo root)"

# REAPER.app wird nicht mitgeliefert und auch nicht aus /Applications in den Ordner kopiert.

# Plugin-Pfad in reaper.ini auf den Installationsort setzen (Quarantaene gibt es bei pkg-Installation nicht)
( cd "$DEST" && /bin/sh ./run-me-before-install.command ) >/dev/null 2>&1 || true

# Portables REAPER schreibt in seinen Ordner -> dem angemeldeten Benutzer uebergeben
/usr/sbin/chown -R "$CONSOLE_USER" "$DEST" 2>/dev/null || true
/bin/chmod -R u+rwX "$DEST" 2>/dev/null || true

if [ ! -d "$DEST/REAPER.app" ]; then
  /bin/cat > "$DEST/REAPER.app FEHLT - bitte lesen.txt" <<'TXT'
REAPER ist aus Lizenzgruenden nicht Teil dieses Pakets.
1. REAPER fuer macOS von https://www.reaper.fm/download.php laden.
2. REAPER.app in DIESEN Ordner (ICST_Ambi_Reaper) legen, neben reaper.ini.
3. 'ICST_Ambi_Reaper starten.command' per Doppelklick ausfuehren (setzt den Plug-in-Pfad und startet REAPER.app aus diesem Ordner).
   Blockiert macOS das Skript: Systemeinstellungen > Datenschutz & Sicherheit > Dennoch oeffnen.
4. Fragt REAPER beim ersten Start "Would you like to scan system VST/CLAP/LV2 paths?": mit No antworten.
   Die Frage erscheint nicht immer. Nur die Plug-ins aus Effects/VST3: REAPER beenden, wieder mit dem .command oeffnen.
5. Die Toolbar ICST_Ambi_Automation erscheint oben im Hauptfenster. Ausfuehrlich: README.md, Abschnitt 2.1.

REAPER is not part of this package for licensing reasons.
1. Download REAPER for macOS from https://www.reaper.fm/download.php
2. Put REAPER.app into THIS folder (ICST_Ambi_Reaper), next to reaper.ini.
3. Double-click 'ICST_Ambi_Reaper starten.command' (sets the plug-in path and starts REAPER.app from this folder).
   If macOS blocks it: System Settings > Privacy & Security > Open Anyway.
4. If REAPER asks on the first start "Would you like to scan system VST/CLAP/LV2 paths?": answer No.
   The question does not always appear. For the plug-ins in Effects/VST3 only: quit REAPER, reopen with the .command.
5. The toolbar ICST_Ambi_Automation appears at the top of the main window. Full guide: README_EN.md, section 2.1.
TXT
  /usr/sbin/chown "$CONSOLE_USER" "$DEST/REAPER.app FEHLT - bitte lesen.txt" 2>/dev/null || true
fi
exit 0
